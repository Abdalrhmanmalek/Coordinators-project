{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Deployment-Test",
          "value": "adco-production-ready"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/manifest.json",
      "destination": "/frontend/manifest.json"
    },
    {
      "source": "/sw.js",
      "destination": "/frontend/sw.js"
    },
    {
      "source": "/assets/:match*",
      "destination": "/frontend/assets/:match*"
    },
    {
      "source": "/css/:match*",
      "destination": "/frontend/css/:match*"
    },
    {
      "source": "/js/:match*",
      "destination": "/frontend/js/:match*"
    },
    {
      "source": "/evaluation",
      "destination": "/frontend/pages/evaluation.html"
    },
    {
      "source": "/evaluation/:id*",
      "destination": "/frontend/pages/evaluation.html"
    },
    {
      "source": "/dashboard",
      "destination": "/frontend/pages/dashboard.html"
    },
    {
      "source": "/login",
      "destination": "/frontend/pages/login.html"
    },
    {
      "source": "/signup",
      "destination": "/frontend/pages/signup-wizard.html"
    },
    {
      "source": "/signup-wizard",
      "destination": "/frontend/pages/signup-wizard.html"
    },
    {
      "source": "/supervisor",
      "destination": "/frontend/pages/supervisor-panel.html"
    },
    {
      "source": "/supervisor-panel",
      "destination": "/frontend/pages/supervisor-panel.html"
    },
    {
      "source": "/analytics",
      "destination": "/frontend/pages/analytics.html"
    },
    {
      "source": "/leaderboard",
      "destination": "/frontend/pages/leaderboard.html"
    },
    {
      "source": "/branch-details",
      "destination": "/frontend/pages/branch-details.html"
    },
    {
      "source": "/activity-card",
      "destination": "/frontend/pages/activity-card.html"
    },
    {
      "source": "/sheets",
      "destination": "/frontend/pages/sheets-view.html"
    },
    {
      "source": "/sheets-view",
      "destination": "/frontend/pages/sheets-view.html"
    },
    {
      "source": "/pages/:page",
      "destination": "/frontend/pages/:page.html"
    },
    {
      "source": "/pages/:page.html",
      "destination": "/frontend/pages/:page.html"
    }
  ]
}
