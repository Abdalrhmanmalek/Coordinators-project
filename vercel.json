{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "^/(index(\\.html)?)?$",
      "dest": "/frontend/index.html"
    },
    {
      "src": "^/pages/(.*)",
      "dest": "/frontend/pages/$1"
    },
    {
      "src": "^/assets/(.*)",
      "dest": "/frontend/assets/$1"
    },
    {
      "src": "^/css/(.*)",
      "dest": "/frontend/css/$1"
    },
    {
      "src": "^/js/(.*)",
      "dest": "/frontend/js/$1"
    },
    {
      "src": "^/manifest\\.json$",
      "dest": "/frontend/manifest.json"
    },
    {
      "src": "^/sw\\.js$",
      "dest": "/frontend/sw.js"
    }
  ]
}
