{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": "/pages/dashboard.html"
    },
    {
      "source": "/supervisor",
      "destination": "/pages/supervisor-panel.html"
    },
    {
      "source": "/supervisor-panel",
      "destination": "/pages/supervisor-panel.html"
    },
    {
      "source": "/evaluation",
      "destination": "/pages/evaluation.html"
    },
    {
      "source": "/evaluation/:id*",
      "destination": "/pages/evaluation.html"
    },
    {
      "source": "/activity-card",
      "destination": "/pages/activity-card.html"
    },
    {
      "source": "/activity-card/:id*",
      "destination": "/pages/activity-card.html"
    },
    {
      "source": "/analytics",
      "destination": "/pages/analytics.html"
    },
    {
      "source": "/leaderboard",
      "destination": "/pages/leaderboard.html"
    },
    {
      "source": "/login",
      "destination": "/pages/login.html"
    },
    {
      "source": "/signup",
      "destination": "/pages/signup-wizard.html"
    },
    {
      "source": "/signup-wizard",
      "destination": "/pages/signup-wizard.html"
    },
    {
      "source": "/sheets",
      "destination": "/pages/sheets-view.html"
    },
    {
      "source": "/sheets-view",
      "destination": "/pages/sheets-view.html"
    },
    {
      "source": "/branch-details",
      "destination": "/pages/branch-details.html"
    },
    {
      "source": "/branch-details/:id*",
      "destination": "/pages/branch-details.html"
    },
    {
      "source": "/pages/:page.html",
      "destination": "/pages/:page.html"
    },
    {
      "source": "/pages/:page",
      "destination": "/pages/:page.html"
    },
    {
      "source": "/pages/:page/:id*",
      "destination": "/pages/:page.html"
    },
    {
      "source": "/:page.html",
      "destination": "/pages/:page.html"
    }
  ]
}
